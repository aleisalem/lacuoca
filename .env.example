# ─────────────────────────────────────────────
#  LaCuoca – Environment Variables
#  Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_NAME=LaCuoca
APP_ENV=development          # development | production
APP_SECRET_KEY=change-me-to-a-random-64-char-string
APP_ALLOWED_ORIGINS=https://localhost:5173,http://localhost:5173,http://localhost:3000

# ── Database ─────────────────────────────────
POSTGRES_USER=lacuoca
POSTGRES_PASSWORD=lacuoca_dev_password
POSTGRES_DB=lacuoca
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lacuoca:lacuoca_dev_password@db:5432/lacuoca
# When connecting from outside Docker (e.g. local tools): use port 5435

# ── Redis ────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ──────────────────────────────────────
JWT_SECRET_KEY=change-me-too-another-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Admin Seed User ──────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@lacuoca.local
ADMIN_PASSWORD=ChangeMe123!

# ── AI / Ollama (external) ───────────────────
# Point this at your external Ollama server. Can also be overridden
# at runtime via the admin settings panel.
AI_PROVIDER=ollama                  # ollama | openai
OLLAMA_BASE_URL=http://192.168.1.x:11434
OLLAMA_MODEL=llama3.2               # default fallback model
OLLAMA_CHAT_MODEL=                  # recipe generation + chat (blank → OLLAMA_MODEL)
OLLAMA_EMBEDDING_MODEL=             # embeddings / semantic search (blank → OLLAMA_MODEL)
OLLAMA_VISION_MODEL=qwen3-vl        # OCR structuring step (Qwen3-VL required)

# ── OpenAI (optional) ────────────────────────
OPENAI_API_KEY=sk-...               # only needed when AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini

# ── Vector Store ─────────────────────────────
VECTOR_STORE_TYPE=pgvector          # pgvector (uses same postgres)

# ── File Storage ─────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
